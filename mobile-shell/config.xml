<?xml version='1.0' encoding='utf-8'?>
<widget id="__APP_BUNDLE_ID__" version="0.1.0"
        ios-CFBundleVersion="1" android-versionCode="1"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">

    <name>__APP_NAME__</name>
    <description>__APP_DESCRIPTION__</description>
    <author email="hello@__APP_DOMAIN__" href="https://__APP_DOMAIN__">Wave Networks</author>

    <!-- LOCAL entry point. Never a remote URL: a remote-URL WebView is the thing
         Apple rejects under 4.2, and it would make the app useless offline. The UI
         is bundled; only DATA and view MARKUP come over the network. -->
    <content src="index.html" />

    <!-- Auto-stamps an always-increasing build number into ios-CFBundleVersion /
         android-versionCode on every build so store uploads never collide. The
         values above are just placeholders the hook overwrites at build time. -->
    <hook type="before_prepare" src="scripts/set-build-number.js" />

    <!-- The device may talk to __APP_DOMAIN__ and nowhere else. -->
    <access origin="https://__APP_DOMAIN__" />
    <allow-navigation href="https://__APP_DOMAIN__/*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-intent href="tel:*" />
    <allow-intent href="mailto:*" />

    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackupWebStorage" value="local" />
    <!-- cordova-ios defaults to iOS 11, which Xcode now warns is below the supported
         floor (12.0). Pin a modern minimum. -->
    <preference name="deployment-target" value="13.0" />
    <preference name="SplashScreenDelay" value="1000" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="SplashScreenBackgroundColor" value="#FF__APP_BRAND_HEX__" />
    <preference name="AndroidWindowSplashScreenBackground" value="#__APP_BRAND_HEX__" />
    <preference name="BackgroundColor" value="#FF__APP_BRAND_HEX__" />

    <platform name="ios">
        <preference name="WKWebViewOnly" value="true" />
        <preference name="scheme" value="app" />
        <preference name="hostname" value="localhost" />
        <!-- WKWebView enforces CORS, which is why core's CORS allowlist + Bearer
             device tokens are hard prerequisites, not polish (spec 05). -->
        <icon src="res/icon/ios/icon-1024.png" width="1024" height="1024" />
        <splash src="res/screen/ios/Default@2x~universal~anyany.png" />
    </platform>

    <platform name="android">
        <!-- Play requires apps to target API 35+ (Android 15). cordova-android 14
             targets 35 by default; set it explicitly so the build can't regress.
             NOTE: cordova-android 13+ serves the app from https://localhost, which
             is why m/js/env.js must detect "bundled" by HOSTNAME, not by protocol. -->
        <preference name="android-targetSdkVersion" value="35" />
        <preference name="AndroidLaunchMode" value="singleTop" />
        <icon src="res/icon/android/ic_launcher.png" density="xxxhdpi" />
        <splash src="res/screen/android/splash-port.png" density="xxxhdpi" />
    </platform>

    <!-- Pinned. An unpinned plugin is a build that breaks on someone else's schedule. -->
    <plugin name="cordova-plugin-statusbar" spec="4.0.0" />
    <plugin name="cordova-plugin-network-information" spec="3.0.0" />
    <plugin name="cordova-plugin-inappbrowser" spec="6.0.0" />
    <plugin name="cordova-plugin-camera" spec="7.0.0" />
    <plugin name="cordova-plugin-media-capture" spec="5.0.0" />

    <!-- Live Updates: replaces the web layer over the air, so a behavior change no longer
         waits on a store review. Only binary-compatible changes may ship this way — adding
         a plugin or touching native code still needs a real release.

         ⚠️ THE FIRST STORE SUBMISSION MUST INCLUDE THIS PLUGIN. A release shipped without
         it can never receive an OTA update — there is no way to add the capability later
         to binaries already on devices.

         APP_ID comes from the Capawesome Cloud app (a UUID). Until it is filled in,
         release-mobile.sh step 8 skips publishing rather than failing.

         DEFAULT_CHANNEL is REWRITTEN BY release-mobile.sh on every build to match the
         widget version above — do not hand-edit it. Pinning the channel to the binary is
         what stops a bundle reaching an app that cannot run it. -->
    <plugin name="@capawesome/cordova-live-update" spec="0.1.0">
        <variable name="APP_ID" value="__CAPAWESOME_APP_ID__" />
        <variable name="DEFAULT_CHANNEL" value="production-0.1.0" />
    </plugin>
</widget>
