# Allow only index.php, deny everything else
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} !/install/index\.php
    RewriteRule !^index\.php$ - [F,L]
</IfModule>

# Fallback: deny directory listings
Options -Indexes

# Set DirectoryIndex
DirectoryIndex index.php
