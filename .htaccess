# Child app .htaccess
# Security & Routing
#
# Paths below assume the app is served under /child-app/. When scaffolding
# a real app, replace "child-app" with your CHILD_APP_SLUG (the deploy
# tooling can template this).

# Custom error pages — logged to DB for security monitoring
ErrorDocument 403 /child-app/error.php
ErrorDocument 404 /child-app/error.php
ErrorDocument 500 /child-app/error.php

# Deny direct web access to sensitive folders via rewrite
<IfModule mod_rewrite.c>
    RewriteEngine On

    # /child-app/ directory index → redirect to login
    RewriteRule ^$ /child-app/auth/login.php [R=302,L]

    # Serve framework content files via PHP proxy
    RewriteRule ^content/(.+)$ content.php?f=$1 [L,QSA]

    # Block access to sensitive directories
    RewriteRule ^(include|config|views|snippets|db_migrations|docker)(/|$) - [F,L]

    # Pretty URLs (optional - index.php handles routing)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
</IfModule>

# Deny access to hidden files (.env, .git, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Deny access to composer and package files
<FilesMatch "^(composer\.(json|lock)|package\.json|package-lock\.json|deploy\.py|deploy_config\.py|deploy_config\.sample\.py|Dockerfile|docker-compose.*\.yml|CLAUDE\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
