# Credentials - config.php is gitignored, config.sample.php is committed
config/config.php

# Deploy credentials (sample is committed)
deploy_config.py

# Docker local overrides
docker-compose.override.yml

# Composer
vendor/

# Node
node_modules/

# Compiled CSS (each developer builds locally via npm run build:css)
assets/themes/glassmorphism/custom.css
assets/themes/glassmorphism/custom.css.map

# Logs and temp
*.log
/tmp/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Claude Code local settings
.claude/

# Mobile bundle (child-app spec 05). Everything under m/ is GENERATED by
# scripts/release-mobile.sh (core engine vendored in) EXCEPT the two you own:
#   m/js/env.js       — your per-app config (domain/name), committed
#   m/scss/*          — optional per-app mobile tweaks, committed
# Committing the rest would fork the engine — the whole thing this design avoids.
/m/index.html
/m/manifest.json
/m/.htaccess
/m/js/*.js
!/m/js/env.js
/m/js/vendor/
/m/js/screens/
/m/js/shell-inline.js
/m/assets/
