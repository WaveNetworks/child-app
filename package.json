{
  "name": "child-app",
  "private": true,
  "description": "Wave Networks child-app template — SCSS theme build pipeline",
  "scripts": {
    "build:css": "sass assets/scss/custom.scss assets/css/custom.css --style compressed --load-path=node_modules",
    "watch": "sass --watch assets/scss/custom.scss:assets/css/custom.css --style expanded --load-path=node_modules",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "bootstrap": "^5.3.2",
    "bootswatch": "^5.3.2",
    "sass": "^1.69.0"
  }
}
